{
  "name": "opencloud",
  "version": "2.2.12",
  "description": "Open Cloud desktop app",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build:dmg-background": "python3 build/create-dmg-background.py",
    "dist": "npm run build:dmg-background && electron-builder",
    "dist:mac": "npm run build:dmg-background && electron-builder --mac dmg --universal && python3 build/fix-dmg-layout.py dist/OpenCloud-2.2.12-mac.dmg",
    "dist:win": "npm run build:dmg-background && electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.15.3"
  },
  "keywords": [],
  "author": "",
  "license": "Private",
  "build": {
    "appId": "com.opencloud.app",
    "productName": "OpenCloud",
    "executableName": "OpenCloud",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "asar": true,
    "files": [
      "electron/**/*",
      "js/**/*",
      "docs/**/*",
      "index.html",
      "styles.css",
      "beta.css",
      "sw.js",
      "version.json",
      "LICENSE",
      "README.md",
      "icon.png",
      "icon.ico",
      "icon.icns",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".env",
        "to": ".env"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "icon.icns",
      "artifactName": "OpenCloud-${version}-mac.${ext}",
      "category": "public.app-category.entertainment",
      "extendInfo": {
        "CFBundleDisplayName": "OpenCloud",
        "CFBundleName": "OpenCloud",
        "CFBundleSpokenName": "Open Cloud"
      }
    },
    "dmg": {
      "background": "build/dmg-background.png",
      "icon": "icon.icns",
      "iconSize": 128,
      "window": {
        "width": 520,
        "height": 260
      },
      "title": "Open Cloud",
      "contents": [
        {
          "x": 132,
          "y": 130,
          "type": "file"
        },
        {
          "x": 388,
          "y": 130,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico",
      "artifactName": "OpenCloud-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OpenCloud",
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico"
    }
  }
}
