{
  "name": "opencloud",
  "version": "3.2.0",
  "description": "Open Cloud desktop app",
  "main": "electron/main.js",
  "scripts": {
    "start": "npm run electron:dev",
    "electron:dev": "electron .",
    "dev:web": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build:web": "vite build",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:mac": "tauri build --target universal-apple-darwin --bundles app,dmg",
    "tauri:build:win": "tauri build --target x86_64-pc-windows-msvc --bundles nsis",
    "check:js": "node scripts/check-js.mjs",
    "test:js": "node --test tests/*.test.mjs",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check": "npm run check:js && npm run test:js && npm run build:web && npm run test:rust",
    "build:dmg-background": "python3 build/create-dmg-background.py",
    "dist": "npm run build:dmg-background && electron-builder",
    "dist:mac": "npm run build:dmg-background && electron-builder --mac dmg --universal && python3 build/fix-dmg-layout.py dist/OpenCloud-3.2.0-mac.dmg",
    "dist:win": "npm run build:dmg-background && electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "electron": "^35.0.0",
    "electron-builder": "^26.15.3",
    "vite": "^7.3.6"
  },
  "keywords": [],
  "author": "",
  "license": "Private",
  "build": {
    "appId": "com.opencloud.app",
    "productName": "OpenCloud",
    "executableName": "OpenCloud",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "asar": true,
    "files": [
      "electron/**/*",
      "js/**/*",
      "docs/**/*",
      "index.html",
      "styles.css",
      "beta.css",
      "sw.js",
      "version.json",
      "LICENSE",
      "README.md",
      "icon.png",
      "icon.ico",
      "icon.icns",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".env",
        "to": ".env"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "icon.icns",
      "artifactName": "OpenCloud-${version}-mac.${ext}",
      "category": "public.app-category.entertainment",
      "extendInfo": {
        "CFBundleDisplayName": "OpenCloud",
        "CFBundleName": "OpenCloud",
        "CFBundleSpokenName": "Open Cloud"
      }
    },
    "dmg": {
      "background": "build/dmg-background.png",
      "icon": "icon.icns",
      "iconSize": 128,
      "window": {
        "width": 520,
        "height": 260
      },
      "title": "Open Cloud",
      "contents": [
        {
          "x": 132,
          "y": 130,
          "type": "file"
        },
        {
          "x": 388,
          "y": 130,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico",
      "artifactName": "OpenCloud-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OpenCloud",
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico"
    }
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@supabase/supabase-js": "^2.110.7"
  }
}
