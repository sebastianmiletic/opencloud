{
"update_url": "https://clients2.google.com/service/update2/crx",

  "manifest_version": 3,
  "name": "__MSG_extension_largeName__",
  "description": "__MSG_extension_description__",
  "version": "1.6.1",
  "default_locale": "en",
  "icons": {
    "16": "icons.png",
    "48": "icons.png",
    "128": "icons.png"
  },
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "activeTab",
    "webNavigation",
    "windows"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "js/background.min.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}

